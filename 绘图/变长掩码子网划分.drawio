        <mxCell id="WKmiiGM5LQGQwJdaSBsJ-1" value="&lt;font face=&quot;Times New Roman&quot;&gt;192.168.100./24&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1">
