        </mxCell>
        <mxCell id="WKmiiGM5LQGQwJdaSBsJ-4" value="&lt;font face=&quot;Times New Roman&quot;&gt;192.168.100.&lt;b&gt;0&lt;/b&gt;/25&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1">
