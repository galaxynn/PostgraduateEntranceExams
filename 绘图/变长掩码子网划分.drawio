          <mxGeometry x="560" y="460" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="WKmiiGM5LQGQwJdaSBsJ-6" value="分析IP地址时，可以仅将&lt;b&gt;有需要的部分&lt;/b&gt;展开为&lt;b&gt;二进制&lt;/b&gt;表示。&lt;br&gt;例如，网络前缀为/24时，我们不关心前24位的网络前缀字段，&lt;b&gt;仅关心后8位的主机号字段&lt;/b&gt;。&lt;br&gt;因为&lt;b&gt;子网划分是将主机号字段进行划分&lt;/b&gt;。&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="230" y="160" width="500" height="70" as="geometry" />
        </mxCell>
        <mxCell id="WKmiiGM5LQGQwJdaSBsJ-7" value="&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; font-size: 14px;&quot;&gt;我们将最后一段展开为二进制，即192.168.100.&lt;b&gt;00000000&lt;/b&gt;/24，我们只关注即将从主机号字段划分出来的“子网号字段”，因此，可以简记为 192.168.100.&lt;b&gt; &lt;/b&gt;/24，甚至可以记为./24，表示未划分前的初始状态。&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="210" y="250" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="WKmiiGM5LQGQwJdaSBsJ-12" value="&lt;font face=&quot;Times New Roman&quot;&gt;192.168.100.0/25&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="120" y="560" width="120" height="60" as="geometry" />
        </mxCell>
