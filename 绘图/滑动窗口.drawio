        <mxCell id="cvXPLULsA2EZyS4j313m-41" value="采用n比特对帧编号，序号空间大小为&lt;span style=&quot;background-color: transparent;&quot;&gt;`2^n`，帧编号范围`[0, 2^n-1]`&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="380" y="20" width="380" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cvXPLULsA2EZyS4j313m-42" value="假设n=3，则`2^3 = 8`, 帧编号范围`[0, 7]`&lt;br&gt;`W_T = 5, W_R = 4`，此时`W_T + W_R &amp;gt; 8`" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="460" y="50" width="260" height="30" as="geometry" />
        </mxCell>
