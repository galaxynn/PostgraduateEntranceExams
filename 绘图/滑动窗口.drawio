        <mxCell id="cvXPLULsA2EZyS4j313m-82" value="假设发送方发出帧0、帧1、帧2、帧3、帧4，接收方均&lt;b&gt;按序正确接收&lt;/b&gt;，但&lt;b&gt;确认帧全部丢失，&lt;/b&gt;则此时窗口情况如下：" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="240" y="320" width="620" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cvXPLULsA2EZyS4j313m-84" value="0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
